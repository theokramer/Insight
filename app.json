{
  "expo": {
    "name": "Insight",
    "slug": "insight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.tk.Insight",
      "appleTeamId": "67AYJ24F97",
      "buildNumber": "20261004",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F7F8F3"
      },
      "predictiveBackGestureEnabled": true,
      "package": "de.tk.insight"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose diagrams to turn into study cards.",
          "cameraPermission": "Photograph a diagram to learn its labels.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "./plugins/withPurchases",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-router"
    ],
    "scheme": "insight",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8F3"
    }
  }
}
